# PlantGuard Central Configuration
# Copy this file to .env and configure your environment

# ── LLM Provider Configuration ──
PLANTGUARD_LLM_PROVIDER=gemini
PLANTGUARD_LLM_MODEL=gemini-3.1-flash-lite
PLANTGUARD_LLM_API_KEY=your_gemini_api_key_here
PLANTGUARD_LLM_BASE_URL=
PLANTGUARD_LLM_TEMPERATURE=0.1
PLANTGUARD_LLM_MAX_TOKENS=4096

# ── Fallback Provider (Optional) ──
PLANTGUARD_FALLBACK_LLM_PROVIDER=
PLANTGUARD_FALLBACK_LLM_MODEL=
PLANTGUARD_FALLBACK_LLM_API_KEY=
PLANTGUARD_FALLBACK_LLM_BASE_URL=
PLANTGUARD_ENABLE_FALLBACK=false

# ── Database & State Storage ──
PLANTGUARD_DATABASE_URL=sqlite:///plantguard.db
PLANTGUARD_MEMORY_DATABASE_URL=sqlite:///plantguard_memory.db
PLANTGUARD_CHECKPOINT_DATABASE_URL=sqlite:///plantguard_checkpoints.db

# ── Qdrant Vector Engine ──
PLANTGUARD_QDRANT_HOST=localhost
PLANTGUARD_QDRANT_PORT=6333
PLANTGUARD_QDRANT_COLLECTION_NAME=plantguard_manuals
PLANTGUARD_QDRANT_USE_IN_MEMORY=true

# ── Observability ──
PLANTGUARD_LANGFUSE_ENABLED=false
PLANTGUARD_LANGFUSE_SECRET_KEY=
PLANTGUARD_LANGFUSE_PUBLIC_KEY=
PLANTGUARD_LANGFUSE_HOST=https://cloud.langfuse.com

# ── REST API ──
PLANTGUARD_API_HOST=0.0.0.0
PLANTGUARD_API_PORT=8000
PLANTGUARD_USE_MOCK_SERVICES=true
